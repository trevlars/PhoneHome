# All-in-one PhoneHome Mothership (hub + SIP bridge) for Docker / Unraid.
# FreePBX stays external — point ARI_URL / SIP_SERVER at your LAN FreePBX host.
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ curl openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json* ./
COPY server/package.json server/
COPY web/package.json web/
COPY gateway/package.json gateway/
COPY control/package.json control/
COPY bridged/package.json bridged/package-lock.json* bridged/
RUN npm ci \
  && cd bridged && npm ci --omit=dev

COPY . .
RUN npm run build -w web

COPY deploy/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENV PORT=8787 \
  DATA_DIR=/app/data \
  NODE_ENV=production \
  BRIDGE_URL=http://127.0.0.1:8790

EXPOSE 8787
EXPOSE 8790
EXPOSE 14000-14050/udp

VOLUME ["/app/data"]

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8787/api/health >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "deploy/phonehome-supervisor.mjs"]
