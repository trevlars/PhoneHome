<?xml version="1.0" encoding="utf-8"?>
<!--
  Animatable so Android 12 draws this at the splash icon's real size.
  A static bitmap is rasterized at 108dp and scaled to 192dp, which is the blur.
  The frame is the same LaunchPhone as the intro, placed at 180/288 of the canvas
  so the 1.5x inset lands it on MainActivity HERO_DP.
-->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:oneshot="true">
    <item
        android:drawable="@drawable/splash_frame"
        android:duration="10000" />
</animation-list>
