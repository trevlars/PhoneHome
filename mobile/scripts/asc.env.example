# App Store Connect API (shared with another app — same key works for all apps on the team).
# Copy to asc.env OR source another app's file directly:
#   source ~/path/to/asc.env
#
# Create keys: https://appstoreconnect.apple.com/access/integrations/api

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=/path/to/AuthKey.p8

# App Review demo login (username is always `test` in metadata/review_information/demo_user.txt).
# Never commit the real password — upload_metadata writes a gitignored demo_password.txt from this.
# ASC_REVIEW_DEMO_PASSWORD=
