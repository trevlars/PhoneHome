# Google Play Console upload (copy to play.env — gitignored).
# Service account: Play Console → Setup → API access → link phonehome-family GCP project,
# then grant this account Release manager (or Admin) on the app.

PLAY_PACKAGE_NAME=app.phonehome.android
PLAY_JSON_KEY_PATH=/path/to/PhoneHome/mobile/scripts/play-console-sa.json

# Release signing (generated locally; back up keystore + passwords).
PLAY_UPLOAD_KEYSTORE=/path/to/PhoneHome/mobile/android/phonehome-upload.keystore
PLAY_UPLOAD_KEY_ALIAS=phonehome-upload
PLAY_UPLOAD_STORE_PASSWORD=
PLAY_UPLOAD_KEY_PASSWORD=
