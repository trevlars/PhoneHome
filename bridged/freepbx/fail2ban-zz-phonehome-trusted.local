# PhoneHome — fail2ban trusted networks
#
# Install to: /etc/fail2ban/jail.d/zz-phonehome-trusted.local   (FreePBX CT 121)
# Then:       systemctl restart fail2ban
# Verify:     fail2ban-client get asterisk-iptables ignoreip
#
# WHY THIS EXISTS
# ---------------
# Analog SIP reaches FreePBX through a socat TLS proxy on the Proxmox host:
#
#     HT801 (10.0.4.x) -> proxy 10.0.5.31:5061 -> FreePBX 10.0.5.105:5061
#
# socat terminates the adapter's TCP connection, so Asterisk sees the *proxy*
# as the source of every request. A single adapter with a stale SIP password
# therefore charges its auth failures against 10.0.5.31. After 5 tries the
# asterisk-iptables jail bans the proxy and every analog line in every
# household drops at once.
#
# That failure is nearly invisible: once the ban is in place Asterisk stops
# logging REGISTER attempts entirely, so the logs look idle rather than broken,
# and the adapter appears to have given up. See docs/ht801-lab.md.
#
# WHY jail.d AND NOT jail.local
# -----------------------------
# /etc/fail2ban/jail.local is generated by the FreePBX sysadmin module and is
# marked "DO NOT HAND EDIT" — edits there are lost on regeneration. fail2ban
# reads jail.d/*.local last, so this file wins and survives.
#
# RESIDUAL RISK
# -------------
# Trusting the proxy means fail2ban can no longer ban a real attacker who
# reaches SIP TLS 5061 through it, because their address is rewritten to
# 10.0.5.31. Brute force is still bounded by generated SIP secrets, and direct
# UDP 5060 scanners are still banned on their true IP. The real fix is to
# forward eero TCP 5061 straight to FreePBX (10.0.5.105) and retire the proxy
# so client IPs survive; tracked in docs/threat-model.md.

[DEFAULT]
ignoreip = 127.0.0.1/8 ::1 10.0.4.0/24 10.0.5.0/24
