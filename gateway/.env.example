PORT=8789
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.phonehome.ios
APNS_KEY_P8=/run/secrets/apns_key
APNS_PRODUCTION=1

# JSON map of managed instance id → 32-byte-or-longer shared secret.
# The control plane supplies this registry in production.
MOTHERSHIP_INSTANCE_SECRETS={"inst_example":"replace-with-strong-instance-secret"}
PUSH_RATE_PER_MINUTE=120
