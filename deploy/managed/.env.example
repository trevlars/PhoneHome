# Public identity
PHONEHOME_HOST=family.example.com
PUBLIC_BASE_URL=https://family.example.com
SIP_PUBLIC_HOST=family.example.com
TURN_EXTERNAL_IP=203.0.113.10
EXT_MEDIA_HOST=203.0.113.10

# Hub / bridge shared authentication
BRIDGE_SECRET=replace-with-32-random-bytes
ARI_URL=http://host.docker.internal:8088
ARI_USER=phonehome
ARI_PASS=replace-with-ari-password
SIP_SERVER=family.example.com
ATA_LAN_PUSH=0

# Hub → host FreePBX extension sync
FREEPBX_SYNC_URL=http://host.docker.internal:8797/sip-secret
FREEPBX_SYNC_TOKEN=replace-with-32-random-bytes

# TURN
TURN_URLS=turn:family.example.com:3478
TURN_USERNAME=phonehome
TURN_CREDENTIAL=replace-with-32-random-bytes
TURN_LAN_URLS=

# Managed control services (enabled after registration)
CONTROL_PLANE_URL=
MOTHERSHIP_INSTANCE_ID=
MOTHERSHIP_INSTANCE_SECRET=
PUSH_GATEWAY_URL=

# Family-sized tenant limits
MOTHERSHIP_MAX_PODS=50
MOTHERSHIP_WARN_PODS=25
MOTHERSHIP_MAX_LINES=250
MOTHERSHIP_WARN_LINES=150
