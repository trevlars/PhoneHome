# PhoneHome bridge (ARI ↔ WebRTC) — lives at $DATA_DIR/bridge.env
# phonehome-init.sh generates this; bridge reads it via EnvironmentFile.

BRIDGE_SECRET=
PHONEHOME_URL=http://127.0.0.1:8787
PHONEHOME_WS=ws://127.0.0.1:8787/ws

# FreePBX ARI (enable in FreePBX: Settings → Asterisk REST Interface)
ARI_URL=http://10.0.0.50:8088
ARI_USER=phonehome
ARI_PASS=change-me
ARI_APP=phonehome

# IP Asterisk uses to reach bridge HTTP (claim URLs, *98 IVR media).
# Usually the PhoneHome host LAN IP when FreePBX is on another VM/box.
EXT_MEDIA_HOST=10.0.0.51
EXT_MEDIA_PORT_BASE=14000
BRIDGE_HTTP_PORT=8790
BRIDGE_HTTP_BIND=0.0.0.0

# Match phonehome.env TURN_* when analog ↔ remote softphone calls need relay.
# TURN_URLS=turn:203.0.113.10:3478
# TURN_LAN_URLS=turn:10.0.0.10:3478
# TURN_USERNAME=phonehome
# TURN_CREDENTIAL=change-me
