[Unit]
Description=Cloudflare Quick Tunnel for Kids Landline
After=network-online.target
Wants=network-online.target

[Service]
# Point at the CT/LAN IP running kids-landline
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --url http://10.0.5.106:8787
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
