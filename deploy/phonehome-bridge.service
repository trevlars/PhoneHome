[Unit]
Description=PhoneHome SIP↔WebRTC bridge (ARI)
After=network.target kids-landline.service
Wants=kids-landline.service

[Service]
Type=simple
WorkingDirectory=/opt/kids-landline/bridged
Environment=PHONEHOME_URL=http://127.0.0.1:8787
Environment=PHONEHOME_WS=ws://127.0.0.1:8787/ws
Environment=ARI_URL=http://10.0.5.105:8088
Environment=ARI_USER=phonehome
Environment=ARI_PASS=PhoneHomeAri!
Environment=ARI_APP=phonehome
Environment=EXT_MEDIA_HOST=10.0.5.106
Environment=EXT_MEDIA_PORT_BASE=14000
Environment=BRIDGE_HTTP_PORT=8790
# TURN for ATA↔remote softphone WebRTC (same coturn as kids-landline). Prefer bridge.env.
# Environment=TURN_URLS=turn:YOUR.PUBLIC.IP:3478
# Environment=TURN_LAN_URLS=turn:10.0.5.31:3478
# Environment=TURN_USERNAME=kidslandline
# Environment=TURN_CREDENTIAL=secret-from-pve-root-creds-file
EnvironmentFile=-/var/lib/kids-landline/bridge.env
ExecStart=/usr/bin/node src/index.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
