# PhoneHome host configuration — copy to $DATA_DIR/phonehome.env
# Run: ./deploy/phonehome-init.sh  (interactive) or edit manually.

# --- Recommended: DuckDNS (free hostname; Mothership keeps the IP updated) ---
# Create a subdomain + token at https://www.duckdns.org then set:
# DUCKDNS_DOMAIN=myfamily
# DUCKDNS_TOKEN=your-token-from-duckdns
# DUCKDNS_HTTPS_PORT=8443
# Supervisor derives PUBLIC_BASE_URL / SIP_PUBLIC_HOST when those are empty.
# Still required: HTTPS reverse proxy + router forward of that port → :8787.

# --- Required for remote cousins (HTTPS + mic) ---
# Public URL parents open on phones (no trailing slash).
# With DuckDNS: https://myfamily.duckdns.org:8443
PUBLIC_BASE_URL=https://phonehome.example.com:8443

# SIP hostname written into HT801 configs (usually same as PUBLIC_BASE_URL hostname).
SIP_PUBLIC_HOST=phonehome.example.com

# --- Data & runtime ---
PORT=8787
DATA_DIR=/var/lib/kids-landline
NODE_ENV=production

# --- Host license (docs/host-license.md) — 30-day trial then $20/year ---
# Lab: leave ENFORCE=0. Production self-host: ENFORCE=1 + PUBLIC_KEY from control plane.
HOST_LICENSE_ENFORCE=0
# HOST_LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
HOST_LICENSE_BUY_URL=https://phonehome.pages.dev/buy.html

# --- FreePBX / analog (full stack) ---
# LAN IP or hostname of your FreePBX box (ARI + SIP registrar).
SIP_SERVER=10.0.0.50
BRIDGE_URL=http://127.0.0.1:8790

# One-tap HT801 push only works when PhoneHome shares a LAN with the adapter.
# Set 0 on cloud/VPS hosts — Parent UI uses Download config instead.
ATA_LAN_PUSH=1
# Optional: household ids that may use one-tap (default: oldest household only).
# ATA_LAN_HOUSEHOLD_IDS=hh_xxxxx

# --- TURN (required for many cross-home softphone calls) ---
# Public WAN IP or hostname + coturn creds (see docs/self-host.md).
# TURN_URLS=turn:203.0.113.10:3478
# TURN_USERNAME=phonehome
# TURN_CREDENTIAL=change-me

# Optional LAN TURN when both phones are home but ICE hairpin fails.
# TURN_LAN_URLS=turn:10.0.0.10:3478

# --- Mothership scale (Pods = households; see docs/glossary.md) ---
# Lines (softphones + ATAs) are the real limit. No Pod cap unless you set one.
# MOTHERSHIP_MAX_LINES=50
# MOTHERSHIP_WARN_LINES=40
# MOTHERSHIP_MAX_PODS=
# MOTHERSHIP_WARN_PODS=
