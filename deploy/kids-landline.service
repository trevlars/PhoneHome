[Unit]
Description=PhoneHome (kids-landline Stage 1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kids-landline
Environment=PORT=8787
Environment=DATA_DIR=/var/lib/kids-landline
Environment=NODE_ENV=production
Environment=PUBLIC_BASE_URL=https://y5876647.eero.online:8443
# Public SIP host for ATA configs (FQDN → Let's Encrypt SAN + P8463=1). Prefer this over SIP_SERVER (LAN IP).
Environment=SIP_PUBLIC_HOST=y5876647.eero.online
# Keep FreePBX sip.secret in lockstep with PhoneHome (remote Download config accuracy).
EnvironmentFile=-/var/lib/kids-landline/freepbx-sync.env
# One-tap HT801 push needs LAN. Shared/cloud hosts: ATA_LAN_PUSH=0 (UI leads with Download config).
# Environment=ATA_LAN_PUSH=0
# TURN (coturn on PVE — see docs/hosting.md). Use public WAN IP after eero port-forward.
# Environment=TURN_URLS=turn:YOUR.PUBLIC.IP:3478
# Environment=TURN_USERNAME=kidslandline
# Environment=TURN_CREDENTIAL=secret-from-pve-root-creds-file
ExecStart=/usr/bin/npm run start -w server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
