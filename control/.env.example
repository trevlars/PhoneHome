PORT=8791
CONTROL_DATA_DIR=/app/data
CONTROL_ADMIN_TOKEN=replace-with-strong-admin-token

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FAMILY=
STRIPE_PRICE_EXTENDED=
# Primary self-host SKU: $25/year host license (Ed25519 signed blob; OWNMS5 = $5 off → $20).
STRIPE_PRICE_HOST_ANNUAL=
HOST_LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
HOST_LICENSE_SUCCESS_URL=https://phonehome.example/buy-success.html?session_id={CHECKOUT_SESSION_ID}
HOST_LICENSE_CANCEL_URL=https://phonehome.example/buy.html
STRIPE_SUCCESS_URL=https://phonehome.example/managed/success
STRIPE_CANCEL_URL=https://phonehome.example/managed
STRIPE_PORTAL_RETURN_URL=https://phonehome.example/managed/account

# Optional managed-VPS SKU (not the primary product story).
PROVISIONER_WEBHOOK_URL=https://provision.phonehome.example/v1/tenants
PROVISIONER_WEBHOOK_SECRET=replace-with-strong-provisioner-secret
